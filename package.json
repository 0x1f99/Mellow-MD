{
  "name": "mellow-md",
  "version": "2.0.0",
  "description": "Self-hosted multi-device WhatsApp bot",
  "keywords": [
    "bot",
    "baileys",
    "mellow",
    "demmy",
    "whatsapp",
    "automation",
    "chat",
    "@whiskeysockets/baileys",
    "Mellow",
    "MD",
    "baileysQR"
  ],
  "license": "MIT",
  "author": "Mellow",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:pm2": "pm2 start index.js --attach --name mellow -- --color",
    "stop": "pm2 stop mellow",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "patch-package --patch-dir src/patches",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "chalk": "^6.0.0",
    "convert-unicode-fonts": "^1.0.1",
    "dotenv": "^17.2.3",
    "file-type": "^22.0.1",
    "genius-lyrics": "^4.4.7",
    "is-emoji": "^0.1.1",
    "linkify-it": "^6.1.0",
    "morsee": "^1.0.10",
    "node-catbox": "^4.2.0",
    "pino": "^10.3.0",
    "pm2": "^6.0.14",
    "ruhend-scraper": "^10.0.3",
    "simple-git": "^3.36.0",
    "tlds": "^1.261.0",
    "yt-search": "^2.13.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
